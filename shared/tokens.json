{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Organica design system — the single source of truth. shared/organica-tokens.css mirrors this file one-for-one; docs/DESIGN-SYSTEM.md documents it; Figma variables and text styles are named to match. When a value changes it changes HERE first, then in the CSS, then in Figma. Anything that disagrees with this file is a bug.",
  "font": {
    "family": {
      "$type": "fontFamily",
      "$value": "Manrope",
      "$description": "One family, everywhere. Variable font, weight axis 200-800. Figma: load from Google Fonts."
    }
  },
  "weight": {
    "$description": "The NUMBER is canonical, not the token name. Figma's weight picker shows the font's own style names (Space Grotesk / IBM Plex Mono), so each stop records the style name it maps to — a token called 'medium' holding 400 would read as 'Regular' in Figma and the two would silently disagree.",
    "regular": {
      "$type": "fontWeight",
      "$value": 400,
      "$description": "Regular — body, panel section titles and controls"
    },
    "medium": {
      "$type": "fontWeight",
      "$value": 500,
      "$description": "Medium — emphasis, primary action, H4/H5"
    },
    "semibold": {
      "$type": "fontWeight",
      "$value": 600,
      "$description": "SemiBold — H2/H3, <strong>"
    },
    "bold": {
      "$type": "fontWeight",
      "$value": 700,
      "$description": "Bold — H1, display, wordmark, overline"
    }
  },
  "size": {
    "$description": "1.2 (minor third) ratio anchored at 11px, rounded to whole pixels so text lands on the pixel grid in a dense UI. Nothing below 9px — it stops being readable at panel density.",
    "micro": {
      "$type": "dimension",
      "$value": "9px"
    },
    "small": {
      "$type": "dimension",
      "$value": "10px"
    },
    "base": {
      "$type": "dimension",
      "$value": "11px"
    },
    "medium": {
      "$type": "dimension",
      "$value": "12px"
    },
    "large": {
      "$type": "dimension",
      "$value": "14px"
    },
    "xl": {
      "$type": "dimension",
      "$value": "17px"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "20px"
    },
    "3xl": {
      "$type": "dimension",
      "$value": "24px"
    },
    "4xl": {
      "$type": "dimension",
      "$value": "32px"
    },
    "5xl": {
      "$type": "dimension",
      "$value": "44px"
    },
    "6xl": {
      "$type": "dimension",
      "$value": "64px",
      "$description": "Display only — --t-display-size is its fluid form"
    }
  },
  "tracking": {
    "$description": "CSS em maps 1:1 to Figma percent — 0.08em = 8%. Do NOT type 0.08 into Figma. Panel type carries no tracking at all; only uppercase micro-labels in the header do.",
    "display": {
      "$type": "dimension",
      "$value": "-0.03em",
      "$figma": "-3%",
      "$description": "Display — big type needs negative"
    },
    "tight": {
      "$type": "dimension",
      "$value": "-0.02em",
      "$figma": "-2%"
    },
    "snug": {
      "$type": "dimension",
      "$value": "-0.01em",
      "$figma": "-1%",
      "$description": "H3"
    },
    "normal": {
      "$type": "dimension",
      "$value": "0",
      "$figma": "0%"
    },
    "wide": {
      "$type": "dimension",
      "$value": "0.05em",
      "$figma": "5%"
    },
    "wider": {
      "$type": "dimension",
      "$value": "0.08em",
      "$figma": "8%"
    },
    "widest": {
      "$type": "dimension",
      "$value": "0.15em",
      "$figma": "15%"
    }
  },
  "lineHeight": {
    "$description": "Unitless so it scales with the element's own size. In Figma enter as a percentage, not pixels, so the style survives a size change.",
    "tight": {
      "$type": "number",
      "$value": 1.15,
      "$figma": "115%",
      "$description": "H1"
    },
    "snug": {
      "$type": "number",
      "$value": 1.45,
      "$figma": "145%"
    },
    "normal": {
      "$type": "number",
      "$value": 1.7,
      "$figma": "170%"
    },
    "heading": {
      "$type": "number",
      "$value": 1.25,
      "$figma": "125%",
      "$description": "H2–H6"
    },
    "none": {
      "$type": "number",
      "$value": 1,
      "$figma": "100%",
      "$description": "Display"
    }
  },
  "textStyle": {
    "$description": "The composed roles — what become Figma text styles, one-for-one. A component references the ROLE, never a raw size or weight. The panel runs on TWO type styles (10/400 and 9/300); hierarchy is carried by COLOUR, not size: --ink for section titles, --accent for labels and controls, --mid for sub-labels and values.",
    "panel/section": {
      "$description": "Panel section title — Presets, Dither, Canopy. Sentence case. Same size and weight as panel/control; the two are told apart by colour (--ink vs --accent) and position, not by type.",
      "size": "{size.small}",
      "weight": "{weight.regular}",
      "tracking": "{tracking.normal}",
      "lineHeight": "{lineHeight.tight}",
      "color": "ink",
      "$figma": {
        "font": "Manrope",
        "style": "Regular",
        "size": 10,
        "letterSpacing": "0%",
        "lineHeight": "120%"
      }
    },
    "panel/sub-label": {
      "$description": "Subdivision inside a section — Algorithm, Resolution, Preview.",
      "size": "{size.micro}",
      "weight": "{weight.light}",
      "tracking": "{tracking.normal}",
      "lineHeight": "{lineHeight.tight}",
      "color": "mid",
      "$figma": {
        "font": "Manrope",
        "style": "Light",
        "size": 9,
        "letterSpacing": "0%",
        "lineHeight": "120%"
      }
    },
    "panel/label": {
      "$description": "Control row label — Grid width, Gamma, Contrast.",
      "size": "{size.micro}",
      "weight": "{weight.light}",
      "tracking": "{tracking.normal}",
      "lineHeight": "{lineHeight.tight}",
      "color": "accent",
      "$figma": {
        "font": "Manrope",
        "style": "Light",
        "size": 9,
        "letterSpacing": "0%",
        "lineHeight": "120%"
      }
    },
    "panel/value": {
      "$description": "Numeric readout. Tabular figures so values don't jitter under a dragging slider.",
      "size": "{size.micro}",
      "weight": "{weight.light}",
      "tracking": "{tracking.normal}",
      "lineHeight": "{lineHeight.tight}",
      "color": "mid",
      "tabularNumbers": true,
      "$figma": {
        "font": "Manrope",
        "style": "Light",
        "size": 9,
        "letterSpacing": "0%",
        "lineHeight": "120%"
      }
    },
    "panel/control": {
      "$description": "Interactive control text — segmented buttons, selects, inputs. One stop above its own label: a control has to read as actionable, and at 300 in a 26px row it goes soft. Stated as a role so the difference is a decision, not an accident of which rule was written last.",
      "size": "{size.small}",
      "weight": "{weight.regular}",
      "tracking": "{tracking.normal}",
      "lineHeight": "{lineHeight.tight}",
      "color": "accent",
      "$figma": {
        "font": "Manrope",
        "style": "Regular",
        "size": 10,
        "letterSpacing": "0%",
        "lineHeight": "120%"
      }
    },
    "header/logo": {
      "$description": "Tool wordmark in the header. The one place uppercase survives.",
      "size": "{size.small}",
      "weight": "{weight.bold}",
      "tracking": "{tracking.widest}",
      "lineHeight": "{lineHeight.tight}",
      "uppercase": true,
      "color": "mid",
      "$figma": {
        "font": "Manrope",
        "style": "Bold",
        "size": 10,
        "letterSpacing": "15%",
        "lineHeight": "120%"
      }
    },
    "header/title": {
      "$description": "Context title in the header — Sketch → SVG, Organic Forms.",
      "size": "{size.medium}",
      "weight": "{weight.medium}",
      "tracking": "{tracking.normal}",
      "lineHeight": "{lineHeight.tight}",
      "color": "ink",
      "$figma": {
        "font": "Manrope",
        "style": "Medium",
        "size": 12,
        "letterSpacing": "0%",
        "lineHeight": "120%"
      }
    },
    "header/action": {
      "$description": "Header button label.",
      "size": "{size.small}",
      "weight": "{weight.medium}",
      "tracking": "{tracking.wider}",
      "lineHeight": "{lineHeight.tight}",
      "uppercase": true,
      "color": "ink",
      "$figma": {
        "font": "Manrope",
        "style": "Medium",
        "size": 10,
        "letterSpacing": "8%",
        "lineHeight": "120%"
      }
    },
    "display/wordmark": {
      "$description": "Display. Fluid on the web (--t-display-size, up to size.6xl); in Figma pick a size per artboard and keep the ratios.",
      "size": "{size.6xl}",
      "weight": "{weight.bold}",
      "tracking": "{tracking.tight}",
      "lineHeight": 0.88,
      "$figma": {
        "font": "Manrope",
        "style": "ExtraBold",
        "size": 96,
        "letterSpacing": "-3%",
        "lineHeight": "88%"
      }
    }
  },
  "space": {
    "$description": "4px base grid.",
    "1": {
      "$type": "dimension",
      "$value": "4px"
    },
    "2": {
      "$type": "dimension",
      "$value": "6px"
    },
    "3": {
      "$type": "dimension",
      "$value": "8px"
    },
    "4": {
      "$type": "dimension",
      "$value": "10px"
    },
    "5": {
      "$type": "dimension",
      "$value": "14px"
    },
    "6": {
      "$type": "dimension",
      "$value": "16px"
    },
    "7": {
      "$type": "dimension",
      "$value": "24px"
    },
    "8": {
      "$type": "dimension",
      "$value": "32px"
    }
  },
  "radius": {
    "$description": "Organica's surfaces are flat and near-square — radius is a whisper, not a feature.",
    "sm": {
      "$type": "dimension",
      "$value": "2px"
    },
    "md": {
      "$type": "dimension",
      "$value": "4px"
    },
    "lg": {
      "$type": "dimension",
      "$value": "8px"
    }
  },
  "layout": {
    "panelWidth": {
      "$type": "dimension",
      "$value": "248px",
      "$description": "One width for every control panel. Was 240 / 244 / 280."
    },
    "rowHeight": {
      "$type": "dimension",
      "$value": "26px",
      "$description": "Every control row, so controls align down the column."
    },
    "headerHeight": {
      "$type": "dimension",
      "$value": "44px"
    }
  },
  "color": {
    "$description": "Surface colours are per-tool (Halide is a darkroom, Komorebi a forest floor), so only the SYSTEM colours live here. Per-tool accents are listed under accent.",
    "borderStrong": {
      "$type": "color",
      "$value": "#958462",
      "$description": "Computed, not eyeballed: 3.27:1 on paper and 3.29:1 on panel (--panel = --control-bg #f3f3f3 since Oct 8, 2026; was 3.03:1 on the retired #eceae4), clearing WCAG 1.4.11 (3:1) on both surfaces a border can land on. A first pass at #b5a992 looked right and measured 2.08:1."
    },
    "accent": {
      "$description": "One identity colour per tool — the hub nav accent and the focus ring. Pick a hue that isn't taken when adding a tool.",
      "genesis": {
        "$type": "color",
        "$value": "#6a9c2e"
      },
      "spore": {
        "$type": "color",
        "$value": "#5a7a96"
      },
      "pollen": {
        "$type": "color",
        "$value": "#c8a83a"
      },
      "livingpath": {
        "$type": "color",
        "$value": "#b48cf0"
      },
      "sinew": {
        "$type": "color",
        "$value": "#b8467a"
      },
      "apostate": {
        "$type": "color",
        "$value": "#9c2b3a"
      },
      "halide": {
        "$type": "color",
        "$value": "#5a7a96"
      },
      "komorebi": {
        "$type": "color",
        "$value": "#8aa054"
      },
      "camoTuring": {
        "$type": "color",
        "$value": "#3f8fa0"
      },
      "warping": {
        "$type": "color",
        "$value": "#a9683e"
      },
      "loom": {
        "$type": "color",
        "$value": "#4a7fc9"
      },
      "membrane": {
        "$type": "color",
        "$value": "#c15b4a"
      },
      "vortex": {
        "$type": "color",
        "$value": "#6d4bd8"
      },
      "fvs": {
        "$type": "color",
        "$value": "#3fa876"
      },
      "tunesutra": {
        "$type": "color",
        "$value": "#c93ed6"
      },
      "mycel": {
        "$type": "color",
        "$value": "#8a7355"
      },
      "colornet": {
        "$type": "color",
        "$value": "#4a5fc7"
      },
      "mote": {
        "$type": "color",
        "$value": "#2f9e8f"
      },
      "blobBoundary": {
        "$type": "color",
        "$value": "#8a8a28"
      },
      "radial": {
        "$type": "color",
        "$value": "#6b6f8c"
      },
      "pulsar": {
