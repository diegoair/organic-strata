      "dapple": {
        "$type": "color",
        "$value": "#d0905a"
      }
    },
    "mid": {
      "$type": "color",
      "$value": "#696256",
      "$description": "The one text colour that IS systematic across tools (labels, values, sub-labels). Computed like borderStrong: 5.4:1 on paper, 5.44:1 on panel (#f3f3f3) -- real headroom above the 4.5:1 AA floor. A July 26, 2026 audit found three different values doing this job before unification: the then-shipped Strata's own --muted #888 (3.17:1, fails), Spore's --mid #c8c0b0 (1.62:1, fails badly), everyone else's #726a5e (4.43:1 on panel, fails). Every tool's --mid / --muted / --ink-muted must resolve to this value."
    },
    "port": {
      "$description": "Node-graph port types (shared/node-canvas.css) — the NODE palette, used only by the node board (Diego, Oct 8, 2026): the cover of 'Essential Color Combinations That Just Work' (Em Sans), sampled pixel-exact and used AS IS (no step towards 3:1 — a standing exception, ledger §3). Dark theme: the cover's cream stands in for its black. Also the node card's solid head.",
      "canvas": {
        "$type": "color",
        "$value": "#131313",
        "$extensions": {
          "organica": {
            "dark": "#f1e1c8",
            "source": "Node palette — black #131313 (dark: cream #f1e1c8)"
          }
        }
      },
      "grid": {
        "$type": "color",
        "$value": "#037cc1",
        "$extensions": {
