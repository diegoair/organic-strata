# Python
__pycache__/
*.py[cod]
*.egg-info/
.env
venv/
.venv/

# Node / Frontend
node_modules/
dist/
.DS_Store

# Vercel
.vercel/
.vercel

# Reference / test imagery — real photos used to tune the tools, deliberately
# kept out of the repo (see docs/KOMOREBI.md §20). Documented as "kept out of
# git" since these folders were created; ignored here so that's actually
# enforced rather than relying on remembering.
komorebi/reference-photos/
halide/test-photos/
strata/test-photos/

# Generated preset previews — one PNG per built-in preset, regenerated on
# demand from the tool itself. Kept local rather than shipped: they are
# tool output, not source, and 1.6MB of them would ride along in every
# deploy for no runtime benefit.
camouflage/previews/

# Local backend scratch output
backend/output/

# Superseded exploration prototypes — kept locally for reference (Vortex
# and Membrane were both migrated to real product tools, /vortex/ and
# /membrane/), untracked from the repo to free up space. flow-field is
# still a live linked exploration (hub nav), so it stays tracked.
explorations/membrane/
explorations/vortex/
