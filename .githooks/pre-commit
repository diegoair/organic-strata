#!/usr/bin/env bash
# Runs scripts/check.py before every commit. Bypass in an emergency: git commit --no-verify
# Enable once per clone:  scripts/install-hooks.sh
root="$(git rev-parse --show-toplevel)"
python3 "$root/scripts/check.py" || { echo; echo "Commit blocked by pre-commit checks."; exit 1; }
# Checks that can't run headless — remind, don't block.
staged="$(git diff --cached --name-only)"
if echo "$staged" | grep -qE '^(fvs/|shared/(shapes|palette|print-size|plate-export)\.)'; then
  echo "REMINDER: FVS (or a shared module it uses) changed — run fvs/_test-regression.html and record it in the commit."
fi
exit 0
