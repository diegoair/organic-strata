#!/usr/bin/env bash
# Runs scripts/check.py before every commit, plus the headless suites (FVS regression, step boards, Figure board, Rhizome)
# that the staged paths touch, in parallel. Bypass in an emergency: git commit --no-verify
# Enable once per clone:  scripts/install-hooks.sh
root="$(git rev-parse --show-toplevel)"
python3 "$root/scripts/check.py" || { echo; echo "Commit blocked by pre-commit checks."; exit 1; }
staged="$(git diff --cached --name-only)"
# The headless suites the staged paths need, run side by side in one call (scripts/test-fvs.sh — each brings its own
# server + Chrome). Was: one after another, ~3–4 min for an FVS commit.
jobs=""
add() { jobs="${jobs:+$jobs,}$1"; }
echo "$staged" | grep -qE '^(fvs/|shared/(shapes|palette|print-size|plate-export)\.)' && add regression
echo "$staged" | grep -qE '^(fvs/js/engine/0[0-3]-|shared/shapes\.|design-system/_fvs-rules\.html|scripts/capture-fvs-atlas)' && add atlas
echo "$staged" | grep -qE '^(fvs/js/(engine/)?0[3-6]-|scripts/test-fvs-generate)' && add generate
echo "$staged" | grep -qE '^(fvs/js/(engine/)?0[0-6]-|fvs/index\.html|scripts/test-fvs-axes|fvs/_axes-baseline)' && add axes
echo "$staged" | grep -qE '^(fvs/js/(engine/)?0[0-6]-|fvs/js/engine/00-core|scripts/test-fvs-lookalikes)' && add lookalikes
echo "$staged" | grep -qE '^(fvs/js/(engine/)?0[0-7]-|fvs/js/engine/00-core|shared/shapes\.js|scripts/test-fvs-aspect)' && add aspect
echo "$staged" | grep -qE '^(fvs/js/(engine/)?0[4-7]-|fvs/index\.html|shared/core\.js|scripts/test-fvs-photo)' && add photo
echo "$staged" | grep -qE '^(rhizome/|shared/node-canvas\.|scripts/test-rhizome)' && add rhizome
echo "$staged" | grep -qE '^(shared/node-canvas\.|shared/core\.js|fvs/js/17-figure|scripts/test-figure-board)' && add figure-board
echo "$staged" | grep -qE '^(shared/node-canvas\.|shared/core\.js|fvs/index\.html|fvs/fvs\.css|fvs/js/(0[5-9]|1[0-8])-|scripts/test-fvs-boards|scripts/lib/)' && add boards
if [ -n "$jobs" ]; then
  echo
  echo "Running the headless suites for what is staged ($jobs)…"
  if ! "$root/scripts/test-fvs.sh" --only "$jobs"; then
    echo
    echo "Commit blocked: a headless suite failed (output above). For an intended FVS regression change, re-record"
    echo "fvs/_regression-baseline.json (scripts/regression.sh --record, review the diff) and stage it in the same commit."
    exit 1
  fi
fi
exit 0
