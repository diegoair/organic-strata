#!/usr/bin/env bash
# Runs scripts/check.py before every commit, plus the headless FVS regression when FVS (or a shared
# module it uses) is staged. Bypass in an emergency: git commit --no-verify
# Enable once per clone:  scripts/install-hooks.sh
root="$(git rev-parse --show-toplevel)"
python3 "$root/scripts/check.py" || { echo; echo "Commit blocked by pre-commit checks."; exit 1; }
staged="$(git diff --cached --name-only)"
if echo "$staged" | grep -qE '^(fvs/|shared/(shapes|palette|print-size|plate-export)\.)'; then
  echo
  echo "FVS (or a shared module it uses) changed — running the headless regression…"
  if ! "$root/scripts/regression.sh"; then
    echo
    echo "Commit blocked: FVS regression failed. If the change is intended, re-record fvs/_regression-baseline.json"
    echo "(open fvs/_test-regression.html, Run, 'Show JSON to record') and stage it in the same commit."
    exit 1
  fi
fi
exit 0
